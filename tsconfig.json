{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@pages/*": [
        "app/pages/*"
      ],
      "@features/*": [
        "app/features/*"
      ],
      "@widgets/*": [
        "app/widgets/*"
      ],
      "@shared/*": [
        "app/shared/*"
      ]
    }
  }
}