{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@/*": [
        "app/*"
      ],
      "@pages/*": [
        "app/pages/*"
      ],
      "@features/*": [
        "app/features/*"
      ],
      "@widgets/*": [
        "app/widgets/*"
      ],
      "@shared/*": [
        "app/shared/*"
      ],
      "@entities/*": [
        "app/entities/*"
      ]

    }
  }
}